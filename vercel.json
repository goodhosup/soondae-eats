{
  "version": 2,
  "name": "soondae-eats",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(nationwide_trucks|crawl_stats)\\.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=600"
        }
      ]
    }
  ]
}
